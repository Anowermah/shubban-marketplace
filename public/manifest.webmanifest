{
  "name": "Shubban Libery",
  "short_name": "Shubban",
  "description": "শুব্বান লাইব্রেরী — বই, জ্ঞান ও মননশীলতার এক সমৃদ্ধ ঠিকানা। উন্মুক্ত ও প্রিমিয়াম ডিজিটাল লাইব্রেরী ও অনলাইন বুকশপ।",
  "start_url": "/",
  "scope": "/",
  "id": "shubban-libery-main-pwa",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "window-controls-overlay"
  ],
  "theme_color": "#C49A45",
  "background_color": "#0E241D",
  "orientation": "any",
  "lang": "bn",
  "dir": "ltr",
  "categories": [
    "books",
    "shopping",
    "education",
    "lifestyle"
  ],
  "icons": [
    {
