  target       String               @default("_self")
  displayOrder Int                  @default(0)
  isEnabled    Boolean              @default(true)
  isMegaMenu   Boolean              @default(false)
  badgeText    String?
  parentId     String?
  parent       NavigationMenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     NavigationMenuItem[] @relation("MenuHierarchy")
