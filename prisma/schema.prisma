// ==========================================
// CUSTOM PAGES & POLICY BUILDER
// ==========================================

model CustomPage {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  subtitle        String?
  content         String
  metaTitle       String?
  metaDescription String?
  template        String    @default("STANDARD") // STANDARD, FULL_WIDTH, LEGAL, LANDING
  isPublished     Boolean   @default(true)
  publishedAt     DateTime? @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug, isPublished])
}

// ==========================================
// AI AUTONOMOUS MANAGEMENT SYSTEM
// ==========================================

model AiConversation {
  id           String      @id @default(cuid())
  userId       String
  title        String
  agentKey     String?     @default("general-ai")
  mode         String?     @default("AUTO") // AUTO, MANUAL
  magazineId   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  messages     AiMessage[]
  tasks        AiTask[]

  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([agentKey])
}

model AiMessage {
  id             String          @id @default(cuid())
  conversationId String
  sender         String          // USER, AI, SYSTEM
  agentKey       String?         // Which agent produced this response
  content        String
  evidenceStatus String?         // VERIFIED, PARTIALLY_VERIFIED, INSUFFICIENT_EVIDENCE
  citations      String?         // JSON string of source citations
  tokensUsed     Int             @default(0)
  createdAt      DateTime        @default(now())

  conversation   AiConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  task           AiTask?

  @@index([conversationId, createdAt])
}

model AiTask {
  id             String            @id @default(cuid())
  conversationId String
  messageId      String?           @unique
  command        String
  intent         String            // HOMEPAGE_UPDATE, BANNER_CREATE, SEO_OPTIMIZE, PRODUCT_ANALYSIS, CAMPAIGN_LAUNCH, APPEARANCE_CHANGE, etc.
  status         String            @default("PLANNED") // PLANNED, PENDING_APPROVAL, EXECUTING, COMPLETED, REJECTED, FAILED, ROLLED_BACK
  safetyMode     String            @default("MODE_B") // MODE_A, MODE_B, MODE_C
  planSummary    String
  beforeState    String?           // JSON snapshot before execution
  afterState     String?           // JSON snapshot after execution
  diffPreview    String?           // JSON comparison for UI diff
  rollbackData   String?           // JSON instructions to revert state
  errorDetails   String?
  executedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  conversation   AiConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        AiMessage?        @relation(fields: [messageId], references: [id])
  steps          AiTaskStep[]
  toolExecutions AiToolExecution[]
  approval       AiApproval?

  @@index([status, safetyMode])
}

model AiTaskStep {
  id           String    @id @default(cuid())
  taskId       String
  stepOrder    Int
  title        String
  toolName     String
  status       String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  result       String?   // JSON output
  task         AiTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, stepOrder])
}

model AiApproval {
  id           String    @id @default(cuid())
  taskId       String    @unique
  requestedBy  String
  approvedBy   String?
  decision     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  comment      String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())
  task         AiTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model AiToolExecution {
  id           String    @id @default(cuid())
  taskId       String
  toolName     String
  inputParams  String    // JSON
  outputData   String?   // JSON
  isSuccess    Boolean   @default(true)
  durationMs   Int       @default(0)
  createdAt    DateTime  @default(now())
  task         AiTask    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([toolName, createdAt])
}

model AiUsageLog {
  id           String    @id @default(cuid())
  userId       String
  provider     String    @default("INTERNAL_ORCHESTRATOR") // GEMINI, OPENAI, INTERNAL_ORCHESTRATOR
  model        String    @default("gemini-2.0-flash")
  promptTokens Int       @default(0)
  compTokens   Int       @default(0)
  totalCostUsd Float     @default(0.0)
  actionType   String
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model AiProviderSetting {
  id           String    @id @default(cuid())
  providerKey  String    @unique // gemini, openai, local
  name         String
  isEnabled    Boolean   @default(false)
  apiKeyEnc    String?   // Encrypted server-side
  modelName    String    @default("gemini-2.0-flash")
  temperature  Float     @default(0.7)
  maxTokens    Int       @default(2048)
  updatedAt    DateTime  @updatedAt
}

// ==========================================
// ADVANCED ISLAMIC AI KNOWLEDGE MODELS
// ==========================================

model QuranVerse {
  id              String             @id @default(cuid())
  surahNumber     Int
  surahNameAr     String             // e.g. "الفاتحة"
  surahNameEn     String             // e.g. "Al-Fatihah"
  surahNameBn     String             // e.g. "সূরা আল-ফাতিহা"
  ayahNumber      Int
  textAr          String             // Full Uthmani Arabic text with Tashkeel
  textNormalized  String             // Normalized Arabic without diacritics for search
  juzNumber       Int                @default(1)
  revelationType  String             @default("MECCAN") // MECCAN, MEDINAN
  translations    QuranTranslation[]
  tafsirEntries   TafsirEntry[]

  @@unique([surahNumber, ayahNumber])
  @@index([surahNumber])
  @@index([textNormalized])
}

model QuranTranslation {
  id           String     @id @default(cuid())
  verseId      String
  verse        QuranVerse @relation(fields: [verseId], references: [id], onDelete: Cascade)
  language     String     // "bn", "en"
  translator   String     // "মুহিউদ্দীন খান", "বায়ান ফাউন্ডেশন", "Sahih International"
  translation  String     // Translated text
  sourceName   String     // e.g. "তাজ কোম্পানী কুরআন শরীফ", "King Fahd Quran Complex"

  @@index([verseId, language])
}

model TafsirEntry {
  id           String     @id @default(cuid())
  verseId      String
  verse        QuranVerse @relation(fields: [verseId], references: [id], onDelete: Cascade)
  sourceName   String     // e.g. "তাফসীরে ইবনে কাসীর", "তাফসীরে জালালাইন", "মাআরিফুল কুরআন"
  author       String     // e.g. "আল্লামা ইবনে কাসীর (রহ.)", "মুফতী মুহাম্মদ শফী (রহ.)"
  volume       Int?
  page         Int?
  content      String     // Rich commentary excerpt
  language     String     @default("bn") // bn, en, ar

  @@index([verseId, sourceName])
}

model HadithCollection {
  id           String        @id @default(cuid())
  slug         String        @unique // "bukhari", "muslim", "abu-dawud", "tirmidhi", "nasai", "ibn-majah"
  nameAr       String        // e.g. "صحيح البخاري"
  nameEn       String        // e.g. "Sahih al-Bukhari"
  nameBn       String        // e.g. "সহীহুল বুখারী"
  compiler     String        // e.g. "ইমাম বুখারী (রহ.)"
  totalHadith  Int           @default(7563)
  isCanonical  Boolean       @default(true)
  entries      HadithEntry[]
}

model HadithEntry {
  id               String           @id @default(cuid())
  collectionId     String
  collection       HadithCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  hadithNumber     Int
  chapterNameBn    String?          // e.g. "কিতাবুল ঈমান (বিশ্বাসের অধ্যায়)"
  chapterNameAr    String?
  chapterNameEn    String?
  narrator         String?          // e.g. "হযরত আবু হুরায়রা (রা.)"
  textAr           String           // Arabic matn with Tashkeel
  textBn           String           // Verified Bengali translation
  textEn           String?          // Verified English translation
  authenticity     String           // "SAHIH", "HASAN", "DAIF", "MUTAWATIR"
  gradingAuthority String           // e.g. "ইমাম বুখারী", "আল্লামা আলবানী", "শায়খ শুআইব আল-আরনাউত"
  topicTag         String           // e.g. "SALAH", "ZAKAH", "SAWM", "TAWHID", "CHARACTER", "PURITY"
  sourceUrl        String?

  @@index([collectionId, hadithNumber])
  @@index([topicTag])
  @@index([authenticity])
}

model ScholarlyReference {
  id                 String   @id @default(cuid())
  topic              String   // e.g. "রুকুতে হাত তোলা (রাফউল ইয়াদাইন)", "তারাভীহর রাকাত সংখ্যা"
  topicEn            String?
  madhhabViewHanafi  String?  // Hanafi perspective with dalil
  madhhabViewMaliki  String?  // Maliki perspective with dalil
  madhhabViewShafii  String?  // Shafi'i perspective with dalil
  madhhabViewHanbali String?  // Hanbali perspective with dalil
  consensusNotes     String?  // Scholarly consensus (Ijma) or difference (Ikhtilaf) reasons
  classicalSources   String?  // e.g. "আল-মাবসূত (সারাখসী), আল-মুগনী (ইবনে কুদামা)"
  createdAt          DateTime @default(now())

  @@index([topic])
}

model IslamicAiConversation {
  id           String             @id @default(cuid())
  userId       String?
  sessionId    String?            // Guest session support
  title        String
  language     String             @default("bn") // bn, en, ar
  mode         String             @default("STANDARD") // STANDARD, RESEARCH
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  messages     IslamicAiMessage[]

  @@index([userId, updatedAt])
  @@index([sessionId])
}

model IslamicAiMessage {
  id                 String                @id @default(cuid())
  conversationId     String
  conversation       IslamicAiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender             String                // "USER", "AI"
  content            String
  evidenceStatus     String                @default("VERIFIED") // VERIFIED, PARTIALLY_VERIFIED, INSUFFICIENT_EVIDENCE
  mode               String                @default("STANDARD")
  citations          IslamicAiCitation[]
  feedback           IslamicAiFeedback[]
  recommendedBookIds String?               // JSON array of Book IDs
  createdAt          DateTime              @default(now())

  @@index([conversationId, createdAt])
}

model IslamicAiCitation {
  id           String           @id @default(cuid())
  messageId    String
  message      IslamicAiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  sourceType   String           // "QURAN", "HADITH", "TAFSIR", "SCHOLARLY"
  referenceId  String           // e.g. "Bukhari:1", "Quran:2:255"
  title        String
  arabicText   String?
  translation  String
  grading      String?
  sourceBook   String
  url          String?
  createdAt    DateTime         @default(now())

  @@index([messageId])
}

model IslamicAiFeedback {
  id            String           @id @default(cuid())
  messageId     String
  message       IslamicAiMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId        String?
  isHelpful     Boolean
  reportedError Boolean          @default(false)
  comment       String?
  createdAt     DateTime         @default(now())

  @@index([messageId])
}

model PushSubscription {
  id                 String    @id @default(cuid())
  userId             String?
  user               User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationType    String    @default("MAIN") // MAIN, ADMIN
  endpoint           String    @unique
  p256dh             String
  auth               String
  userAgent          String?
  subscriptionStatus String    @default("ACTIVE") // ACTIVE, EXPIRED, UNSUBSCRIBED
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastUsedAt         DateTime?

  @@index([userId])
  @@index([applicationType])
  @@index([subscriptionStatus])
}

model PushNotificationPreference {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationType      String   @default("MAIN") // MAIN, ADMIN
  notificationCategory String   // ORDERS, PROMOTIONS, SYSTEM, SECURITY, INVENTORY, SHIPMENT
  enabled              Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  @@unique([userId, applicationType, notificationCategory])
  @@index([userId])
}

model PushNotificationLog {
  id                   String    @id @default(cuid())
  recipientId          String?
  recipient            User?     @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  applicationType      String    @default("MAIN") // MAIN, ADMIN
  notificationCategory String
  title                String
  body                 String
  deliveryStatus       String    @default("SENT") // SENT, FAILED, RETRYING
  providerResponse     String?
  retryCount           Int       @default(0)
  createdAt            DateTime  @default(now())
  sentAt               DateTime?

  @@index([applicationType])
  @@index([deliveryStatus])
  @@index([createdAt])
  @@index([recipientId])
}

// ==========================================
// SHUBBAN AI STUDIO MODELS
// ==========================================

model AiAgent {
  id             String   @id @default(cuid())
  key            String   @unique // general-ai, islamic-ai, research-ai, magazine-ai, marketplace-ai, website-ai, support-ai, seo-ai, business-ai, design-ai, video-ai, knowledge-ai
  name           String
  nameEn         String
  description    String
  department     String   // GENERAL, ISLAMIC, EDITORIAL, COMMERCE, OPERATIONS, MARKETING, ANALYTICS, CREATIVE
  icon           String   @default("Bot")
  enabled        Boolean  @default(true)
  providerId     String?
  modelName      String?
  systemPrompt   String
  knowledgeScope String?  // ALL, QURAN_HADITH, MARKETPLACE, MAGAZINE, OPERATIONS, INTERNAL
  allowedTools   String?  // JSON string array of tool names
  permissions    String?  // JSON string
  safetyMode     String   @default("MODE_A") // MODE_A, MODE_B, MODE_C
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AiProviderConfig {
  id              String   @id @default(cuid())
  providerKey     String   @unique // OPENAI, GEMINI, ANTHROPIC, OLLAMA, LOCAL_RAG
  name            String
  apiKey          String?
  apiEndpoint     String?
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  modelsSupported String?  // JSON string array
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AiKnowledgeSource {
  id             String    @id @default(cuid())
  title          String
  sourceType     String    // QURAN, HADITH, TAFSIR, ARTICLE, MAGAZINE, BOOK, DOCUMENT, POLICY, URL
  description    String?
  tenantScope    String?   // GLOBAL or magazineId
  isPublic       Boolean   @default(true)
  status         String    @default("ACTIVE") // ACTIVE, INDEXING, ERROR, DISABLED
  documentCount  Int       @default(0)
  chunkCount     Int       @default(0)
  lastIndexedAt  DateTime?
  metadata       String?   // JSON string
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AiAutomationWorkflow {
  id             String    @id @default(cuid())
  name           String
  description    String?
  triggerType    String    @default("MANUAL") // SCHEDULE, EVENT, MANUAL
  cronExpression String?   // e.g. "0 9 * * *"
  eventName      String?   // e.g. "ORDER_CREATED", "ISSUE_PUBLISHED"
  agentKey       String    @default("general-ai")
  actionType     String    // REPORT, AUDIT, REMINDER, DRAFT_GENERATE, SYNC
  parameters     String?   // JSON string
  status         String    @default("ACTIVE") // ACTIVE, PAUSED, ERROR
  isEnabled      Boolean   @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  lastRunStatus  String?   // SUCCESS, FAILED
  executionCount Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ========================================================
// ADMINISTRATIVE STAFF & HRMS RESPONSIBILITY MODULE
// ========================================================

model Department {
  id          String         @id @default(cuid())
  name        String
  nameEn      String?
  slug        String         @unique
  code        String         @unique
  description String?
  headId      String?
  head        User?          @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  status      String         @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  designations Designation[]
  staffMembers StaffProfile[]
  tasks        StaffTask[]

  @@index([status])
}

model Designation {
  id           String         @id @default(cuid())
  name         String
  nameEn       String?
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  level        Int            @default(1) // 1 (Junior) to 10 (Director/C-level)
  description  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  staffMembers StaffProfile[]

  @@index([departmentId])
}

model StaffProfile {
  id                  String               @id @default(cuid())
  userId              String               @unique
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId          String               @unique // e.g. "SL-EMP-001"
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId       String?
  designation         Designation?         @relation(fields: [designationId], references: [id], onDelete: SetNull)
  supervisorId        String?
  supervisor          StaffProfile?        @relation("StaffSupervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  subordinates        StaffProfile[]       @relation("StaffSupervision")
  
  employmentType      String               @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, INTERN, VOLUNTEER
  employmentStatus    String               @default("ACTIVE") // ACTIVE, ON_LEAVE, PROBATION, SUSPENDED, TERMINATED, RESIGNED
  joiningDate         DateTime             @default(now())
  workResponsibilities String?
  emergencyContact    String?              // JSON string e.g. { name: "", relation: "", phone: "" }
  professionalBio     String?
  internalNotes       String?              // Admin-only confidential notes
  salaryGrade         String?              // Grade A, Grade B, etc.
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  attendances         StaffAttendance[]
  leaveRequests       StaffLeaveRequest[]

  @@index([departmentId])
  @@index([designationId])
  @@index([employmentStatus])
  @@index([employeeId])
}

model StaffTask {
  id            String             @id @default(cuid())
  title         String
  description   String?
  departmentId  String?
  department    Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creatorId     String
  creator       User               @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeId    String?
  assignee      User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  priority      String             @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status        String             @default("TODO") // TODO, IN_PROGRESS, REVIEW, COMPLETED, CANCELLED
  progress      Int                @default(0) // 0 to 100 percentage
  startDate     DateTime?
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  comments      StaffTaskComment[]

  @@index([departmentId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
}

model StaffTaskComment {
  id            String    @id @default(cuid())
  taskId        String
  task          StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  attachmentUrl String?
  createdAt     DateTime  @default(now())

  @@index([taskId])
  @@index([authorId])
}

model StaffApproval {
  id            String    @id @default(cuid())
  title         String
  type          String    // CONTENT_PUBLISH, EXPENSE, LEAVE, PRODUCT_APPROVAL, GENERAL
  requestedById String
  requestedBy   User      @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewerId    String?
  reviewer      User?     @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  details       String?   // JSON or text description
  remarks       String?   // Reviewer notes
  decisionAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([type])
  @@index([requestedById])
  @@index([reviewerId])
}

model StaffAttendance {
  id             String       @id @default(cuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  checkInTime    DateTime?
  checkOutTime   DateTime?
  status         String       @default("PRESENT") // PRESENT, LATE, HALF_DAY, ABSENT, ON_LEAVE
  remarks        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([staffProfileId])
  @@index([date])
  @@index([status])
}

model StaffLeaveRequest {
  id              String       @id @default(cuid())
  staffProfileId  String
  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  leaveType       String       @default("CASUAL") // CASUAL, SICK, ANNUAL, MATERNITY, UNPAID, OTHER
  startDate       DateTime
  endDate         DateTime
  daysCount       Int          @default(1)
  reason          String
  status          String       @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  approvedById    String?
  approvedBy      User?        @relation("LeaveApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  decisionRemarks String?
  decisionAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([staffProfileId])
  @@index([status])
  @@index([leaveType])
}

// ==========================================
// SHUBBAN ADS NETWORK MODELS
// ==========================================

model Advertiser {
  id                 String             @id @default(cuid())
  name               String             // Contact person / Display name
  companyName        String             // Business / Organization name
  slug               String             @unique
  logoUrl            String?
  website            String?
  email              String
  phone              String?
  address            String?
  city               String?
  country            String?            @default("Bangladesh")
  taxId              String?            // BIN, TIN or Trade License Number
  verificationDocUrl String?
  status             String             @default("PENDING") // PENDING, ACTIVE, SUSPENDED, REJECTED
  verifiedAt         DateTime?
  rejectionReason    String?
  internalNotes      String?            // Admin-only confidential notes
  ownerId            String
  owner              User               @relation("AdvertiserOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  members            AdvertiserMember[]
  campaigns          AdCampaign[]
  creatives          AdCreative[]
  invoices           AdInvoice[]
  payments           AdPayment[]
  refunds            AdRefund[]
  staffAssignments   AdStaffAssignment[]

  @@index([status])
  @@index([ownerId])
  @@index([email])
}

model AdvertiserMember {
  id            String      @id @default(cuid())
  advertiserId  String
  advertiser    Advertiser  @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String      @default("MANAGER") // OWNER, MANAGER, BILLING, VIEWER
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([advertiserId, userId])
  @@index([advertiserId])
  @@index([userId])
}

model AdPlacement {
  id                String                 @id @default(cuid())
  placementKey      String                 @unique // e.g. "home_top", "article_inline_1", "magazine_sidebar", "marketplace_top"
  name              String                 // e.g. "হোমপেজ টপ লিডারবোর্ড ব্যানার"
  description       String?
  pageType          String                 @default("HOME") // HOME, ARTICLE, ESSAY, MAGAZINE, MARKETPLACE, RESEARCH, GLOBAL
  desktopWidth      Int                    @default(728)
  desktopHeight     Int                    @default(90)
  tabletWidth       Int?                   @default(468)
  tabletHeight      Int?                   @default(60)
  mobileWidth       Int                    @default(320)
  mobileHeight      Int                    @default(50)
  supportedFormats  String                 @default("[\"LEADERBOARD_BANNER\",\"RESPONSIVE_BANNER\"]") // JSON array
  maxAds            Int                    @default(1)
  position          String?                @default("TOP") // TOP, HERO_BELOW, MIDDLE, BOTTOM, SIDEBAR, INLINE
  rotationRule      String                 @default("WEIGHTED") // WEIGHTED, EVEN, PRIORITY
  frequencyCap      Int                    @default(5) // Max impressions per user session/day
  isLazyLoad        Boolean                @default(true)
  isBlocked         Boolean                @default(false) // Hard editorial block (e.g. sensitive pages)
  status            String                 @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  campaignPlacements AdCampaignPlacement[]
  pricingPackages    AdPricingPackage[]
  impressions        AdImpressionEvent[]
  clicks             AdClickEvent[]

  @@index([pageType])
  @@index([status])
  @@index([position])
}

model AdPricingPackage {
  id                  String       @id @default(cuid())
  name                String       // e.g. "হোমপেজ ১ সপ্তাহের প্রিমিয়াম প্যাকেজ"
  description         String?
  placementId         String?
  placement           AdPlacement? @relation(fields: [placementId], references: [id], onDelete: SetNull)
  pricingModel        String       @default("FIXED_TENURE") // FIXED_TENURE, CPM, CPC, SPONSORSHIP
  durationDays        Int          @default(7) // 7, 15, 30 days
  price               Float        @default(1000.0) // In BDT
  includedImpressions Int?         // Est or capped impressions if any
  includedClicks      Int?         // Est or capped clicks if any
  isFeatured          Boolean      @default(false)
  status              String       @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  campaigns           AdCampaign[]

  @@index([placementId])
  @@index([pricingModel])
  @@index([status])
}

model AdCreative {
  id               String               @id @default(cuid())
  advertiserId     String
  advertiser       Advertiser           @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  name             String               // e.g. "শীতকালীন বইমেলা অফার ব্যানার"
  format           String               @default("LEADERBOARD_BANNER") // LEADERBOARD_BANNER, LARGE_RECTANGLE, MEDIUM_RECTANGLE, SQUARE_BANNER, SIDEBAR_BANNER, RESPONSIVE_BANNER, NATIVE_AD, SPONSORED_ARTICLE, SPONSORED_BOOK, SPONSORED_PUBLISHER, TEXT_AD, VIDEO_AD, ANNOUNCEMENT
  mediaUrl         String               // Image / Video storage path or URL
  mimeType         String               @default("image/webp")
  mediaSize        Int?                 // File size in bytes
  headline         String?              // Required for Native & Text ads
  description      String?              // Body copy
  ctaText          String?              @default("বিস্তারিত দেখুন") // e.g. "এখনই কিনুন", "অর্ডার করুন", "পড়ুন"
  destinationUrl   String               // Safe validated target URL
  altText          String?              // Accessibility text
  mobileMediaUrl   String?              // Optional mobile-optimized creative variant
  desktopMediaUrl  String?
  language         String               @default("bn") // bn, ar, en
  approvalStatus   String               @default("DRAFT") // DRAFT, PENDING_REVIEW, APPROVED, REJECTED, REVISION_REQUIRED
  rejectionReason  String?
  reviewNotes      String?              // Internal reviewer feedback
  approvedById     String?
  approvedBy       User?                @relation("CreativeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  campaignCreatives AdCampaignCreative[]
  impressions      AdImpressionEvent[]
  clicks           AdClickEvent[]

  @@index([advertiserId])
  @@index([format])
  @@index([approvalStatus])
}

model AdCampaign {
  id                  String               @id @default(cuid())
  campaignNumber      String               @unique // e.g. "SL-AD-2026-0001"
  advertiserId        String
  advertiser          Advertiser           @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  name                String               // e.g. "কুরআন শিক্ষা অ্যাপ প্রমোশন ক্যাম্পেইন"
  objective           String               @default("BRAND_AWARENESS") // BRAND_AWARENESS, TRAFFIC, SALES, APP_PROMOTION
  campaignType        String               @default("BANNER") // BANNER, NATIVE, SPONSORSHIP, PRODUCT_FEATURE
  pricingModel        String               @default("FIXED_TENURE") // FIXED_TENURE, CPM, CPC, SPONSORSHIP
  pricingPackageId    String?
  pricingPackage      AdPricingPackage?    @relation(fields: [pricingPackageId], references: [id], onDelete: SetNull)
  budget              Float                @default(0.0)
  spentAmount         Float                @default(0.0)
  agreedPrice         Float                @default(0.0)
  startDate           DateTime
  endDate             DateTime
  deliveryPriority    Int                  @default(5) // 1 (lowest) to 10 (highest)
  frequencyCapPerUser Int                  @default(3) // Impressions per user per day
  dailyDeliveryLimit  Int?                 // Optional cap on daily impressions/spend
  targetingRules      String?              @default("{}") // JSON string
  approvalStatus      String               @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, REVISION_REQUIRED, APPROVED, REJECTED
  status              String               @default("DRAFT") // DRAFT, PENDING_APPROVAL, SCHEDULED, ACTIVE, PAUSED, COMPLETED, CANCELLED, EXPIRED
  billingStatus       String               @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, REFUNDED
  createdById         String
  createdBy           User                 @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedById        String?
  approvedBy          User?                @relation("CampaignApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  rejectionReason     String?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  placements          AdCampaignPlacement[]
  creatives           AdCampaignCreative[]
  invoices            AdInvoice[]
  payments            AdPayment[]
  impressions         AdImpressionEvent[]
  clicks              AdClickEvent[]
  staffAssignments    AdStaffAssignment[]

  @@index([advertiserId])
  @@index([status])
  @@index([approvalStatus])
  @@index([billingStatus])
  @@index([startDate, endDate])
  @@index([deliveryPriority])
}

model AdCampaignPlacement {
  id            String       @id @default(cuid())
  campaignId    String
  campaign      AdCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placementId   String
  placement     AdPlacement  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([campaignId, placementId])
  @@index([campaignId])
  @@index([placementId])
}

model AdCampaignCreative {
  id            String       @id @default(cuid())
  campaignId    String
  campaign      AdCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creativeId    String
  creative      AdCreative   @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  weight        Int          @default(100) // Rotation weight (1-100)
  createdAt     DateTime     @default(now())

  @@unique([campaignId, creativeId])
  @@index([campaignId])
  @@index([creativeId])
}

model AdInvoice {
  id              String       @id @default(cuid())
  invoiceNumber   String       @unique // e.g. "INV-AD-2026-0001"
  advertiserId    String
  advertiser      Advertiser   @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        AdCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  amount          Float        @default(0.0)
  taxAmount       Float        @default(0.0)
  discountAmount  Float        @default(0.0)
  totalAmount     Float        @default(0.0)
  currency        String       @default("BDT")
  status          String       @default("DRAFT") // DRAFT, ISSUED, PAID, OVERDUE, CANCELLED, REFUNDED
  dueDate         DateTime
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  payments        AdPayment[]

  @@index([advertiserId])
  @@index([campaignId])
  @@index([status])
  @@index([invoiceNumber])
}

model AdPayment {
  id              String       @id @default(cuid())
  transactionId   String       @unique // Gateway or bank transaction id
  invoiceId       String?
  invoice         AdInvoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  advertiserId    String
  advertiser      Advertiser   @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaignId      String?
  campaign        AdCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  amount          Float
  currency        String       @default("BDT")
  paymentGateway  String       @default("BKASH") // BKASH, NAGAD, SSLCOMMERZ, BANK_TRANSFER, MANUAL
  gatewayRef      String?      // Reference token or payment ID from provider
  status          String       @default("PENDING") // PENDING, COMPLETED, FAILED, CANCELLED, REFUNDED
  verifiedAt      DateTime?
  rawResponse     String?      // JSON string of gateway callback
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  refunds         AdRefund[]

  @@index([advertiserId])
  @@index([campaignId])
  @@index([invoiceId])
  @@index([status])
  @@index([transactionId])
}

model AdRefund {
  id              String       @id @default(cuid())
  paymentId       String
  payment         AdPayment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  advertiserId    String
  advertiser      Advertiser   @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  amount          Float
  reason          String
  status          String       @default("REQUESTED") // REQUESTED, APPROVED, PROCESSED, REJECTED
  processedById   String?
  processedAt     DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([paymentId])
  @@index([advertiserId])
  @@index([status])
}

model AdImpressionEvent {
  id                  String       @id @default(cuid())
  eventType           String       @default("IMPRESSION") // REQUEST, IMPRESSION, VIEWABLE_IMPRESSION
  campaignId          String
  campaign            AdCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creativeId          String
  creative            AdCreative   @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  placementId         String
  placement           AdPlacement  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  advertiserId        String
  userIpHash          String       // SHA-256 hash
  deviceClass         String       @default("DESKTOP") // DESKTOP, MOBILE, TABLET
  pageUrl             String?
  anonymousSessionId  String?
  timestamp           DateTime     @default(now())

  @@index([campaignId])
  @@index([placementId])
  @@index([creativeId])
  @@index([advertiserId])
  @@index([timestamp])
  @@index([eventType])
}

model AdClickEvent {
  id                  String       @id @default(cuid())
  campaignId          String
  campaign            AdCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creativeId          String
  creative            AdCreative   @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  placementId         String
  placement           AdPlacement  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  advertiserId        String
  destinationUrl      String
  userIpHash          String       // SHA-256 hash
  anonymousSessionId  String?
  isValid             Boolean      @default(true) // False if bot or rapid click fraud
  invalidReason       String?      // e.g. "RAPID_CLICK", "BOT_UA", "SELF_CLICK"
  timestamp           DateTime     @default(now())

  @@index([campaignId])
  @@index([placementId])
  @@index([creativeId])
  @@index([advertiserId])
  @@index([timestamp])
  @@index([isValid])
}

model AdDailyMetric {
  id                       String   @id @default(cuid())
  date                     String   // "YYYY-MM-DD"
  campaignId               String?
  placementId              String?
  advertiserId             String?
  requestsCount            Int      @default(0)
  impressionsCount         Int      @default(0)
  viewableImpressionsCount Int      @default(0)
  clicksCount              Int      @default(0)
  spendAmount              Float    @default(0.0)
  uniqueUsersCount         Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([date, campaignId, placementId])
  @@index([date])
  @@index([campaignId])
  @@index([placementId])
  @@index([advertiserId])
}

model AdStaffAssignment {
  id              String       @id @default(cuid())
  staffId         String
  staff           User         @relation("StaffAdAssignee", fields: [staffId], references: [id], onDelete: Cascade)
  advertiserId    String?
  advertiser      Advertiser?  @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  campaignId      String?
  campaign        AdCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  role            String       @default("ACCOUNT_MANAGER") // SALES_MANAGER, ACCOUNT_MANAGER, AD_REVIEWER, BILLING_OFFICER
  commissionRate  Float        @default(0.0) // Percentage (e.g. 5.0 for 5%)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([staffId])
  @@index([advertiserId])
  @@index([campaignId])
}

model AdAuditLog {
  id              String       @id @default(cuid())
  actorId         String?
  actor           User?        @relation("AdAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName       String?
  actorRole       String?
  action          String       // e.g. "CAMPAIGN_APPROVED", "CREATIVE_REJECTED", "PAYMENT_VERIFIED", "PLACEMENT_TOGGLED"
  entityType      String       // CAMPAIGN, CREATIVE, PLACEMENT, ADVERTISER, INVOICE, PAYMENT, POLICY
  entityId        String?
  details         String?      // JSON string
  ipAddress       String?      // Coarse or hashed
  createdAt       DateTime     @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model AdPolicySetting {
  id              String       @id @default(cuid())
  key             String       @unique // e.g. "disallowed_categories", "max_daily_budget", "frequency_cap_default"
  value           String
  description     String?
  updatedAt       DateTime     @updatedAt
}

// ==========================================
// CENTRAL MEDIA MANAGEMENT & DAM SYSTEM
// ==========================================

model MediaFolder {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  parentId        String?
  color           String?        @default("#C49A45")
  icon            String?        @default("folder")
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  parent          MediaFolder?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders      MediaFolder[]  @relation("FolderHierarchy")
  assets          MediaAsset[]

  @@index([parentId])
  @@index([slug])
  @@index([createdAt])
}

model MediaAsset {
  id                String            @id @default(cuid())
  title             String
  altText           String?
  caption           String?
  description       String?
  fileName          String
  originalName      String
  storageKey        String            @unique // Unique path or S3 key
  storageType       String            @default("LOCAL") // LOCAL, S3, CLOUD
  publicUrl         String
  thumbnailUrl      String?
  mediumUrl         String?
  mimeType          String
  extension         String
  mediaType         String            // IMAGE, PDF, DOCUMENT, AUDIO, VIDEO, ARCHIVE, OTHER
  fileSizeBytes     Int
  fileSizeFormatted String
  width             Int?
  height            Int?
  aspectRatio       String?
  duration          Float?            // in seconds for audio/video
  pageCount         Int?              // for PDFs / documents
  checksum          String?           // SHA-256 hash for duplicate detection
  visibility        String            @default("PUBLIC") // PUBLIC, PRIVATE, RESTRICTED
  isTrash           Boolean           @default(false)
  trashedAt         DateTime?
  folderId          String?
  uploadedBy        String?           // Operator name or userId
  publisherId       String?
  magazineId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  folder            MediaFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  variants          MediaVariant[]
  references        MediaReference[]
  tags              MediaAssetTag[]

  @@index([mediaType])
  @@index([visibility])
  @@index([isTrash])
  @@index([folderId])
  @@index([checksum])
  @@index([createdAt])
}

model MediaVariant {
  id                String       @id @default(cuid())
  assetId           String
  variantName       String       // THUMBNAIL, MEDIUM, WEBP, OPTIMIZED
  storageKey        String
  publicUrl         String
  width             Int?
  height            Int?
  fileSizeBytes     Int
  mimeType          String
  createdAt         DateTime     @default(now())

  asset             MediaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([variantName])
}

model MediaReference {
  id                String       @id @default(cuid())
  assetId           String
  module            String       // PRODUCT, BOOK, BANNER, MAGAZINE, ISSUE, ARTICLE, AUTHOR, PUBLISHER, ADS_CREATIVE, AVATAR, ISLAMIC_AI
  entityId          String       // Foreign ID of referencing record
  entityTitle       String?
  field             String?      // e.g. "coverImage", "pdfUrl", "avatarUrl", "mediaUrl"
  createdAt         DateTime     @default(now())

  asset             MediaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, module, entityId, field])
  @@index([assetId])
  @@index([module, entityId])
}

model MediaTag {
  id                String          @id @default(cuid())
  name              String          @unique
  slug              String          @unique
  color             String?         @default("#C49A45")
  createdAt         DateTime        @default(now())

  assets            MediaAssetTag[]

  @@index([name])
  @@index([slug])
}

model MediaAssetTag {
  id                String       @id @default(cuid())
  assetId           String
  tagId             String

  asset             MediaAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag               MediaTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([assetId, tagId])
  @@index([assetId])
  @@index([tagId])
}

model MediaAuditLog {
  id                String       @id @default(cuid())
  assetId           String?
  action            String       // UPLOAD, EDIT, DELETE, RESTORE, TRASH, MOVE, BULK_DELETE, SIGNED_URL_ACCESS
  actorId           String?
  actorName         String?
  details           String?      // JSON string
  ipAddress         String?
  createdAt         DateTime     @default(now())

  @@index([assetId])
  @@index([action])
  @@index([createdAt])
}













