generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  name            String
  phone           String?
  role            String         @default("REGISTERED_MEMBER") // GUEST, REGISTERED_MEMBER, PAID_MEMBER, AUTHOR, CONTRIBUTOR, REVIEWER, EDITOR, PUBLISHER, STORE_MANAGER, CUSTOMER_SUPPORT, MODERATOR, FINANCE_MANAGER, ADMIN, SUPER_ADMIN
  avatarUrl       String?
  bio             String?
  isVerified      Boolean        @default(false)
  username        String?        @unique
  dateOfBirth     String?
  gender          String?        // MALE, FEMALE, OTHER
  status          String         @default("ACTIVE") // ACTIVE, INACTIVE, PENDING_VERIFICATION, SUSPENDED, BLOCKED
  isPhoneVerified Boolean        @default(false)
  lastLoginAt     DateTime?
  customerType    String         @default("INDIVIDUAL") // INDIVIDUAL, BUSINESS, INSTITUTIONAL, WHOLESALE
  customerTags    String?        // JSON string e.g. ["VIP", "Regular", "High Value"]
  adminNotes      String?        // Internal notes for admin
  country         String?        @default("Bangladesh")
  division        String?
  city            String?
  area            String?
  postalCode      String?
  fullAddress     String?
  membershipTier  String         @default("FREE") // FREE, DIGITAL, PREMIUM, INSTITUTIONAL
  membershipExpiry DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orders          Order[]
  reviews         Review[]
  comments        Comment[]
  questions       Question[]
  answers         Answer[]
  votes           Vote[]
  bookmarks       Bookmark[]
  readingProgress ReadingProgress[]
  entitlements    DigitalEntitlement[]
  subscriptions   Subscription[]
  submissions     Submission[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  authorProfile   Author?
  publisherProfile Publisher?
  vendorMembers   VendorMember[]
  donations       Donation[]
  vendorApps      VendorApplication[]
  supportTickets  SupportTicket[]
  ticketResponses TicketResponse[]
  addresses       Address[]
  returnRequests  ReturnRequest[]
  aiConversations AiConversation[]
  aiUsageLogs     AiUsageLog[]
  pushSubscriptions PushSubscription[]
  pushPreferences PushNotificationPreference[]
  pushLogs        PushNotificationLog[]
  readingSessions     ReadingSession[]
  publicationDownloads PublicationDownload[]
  publicationShares   PublicationShare[]
  issueReadingProgress IssueReadingProgress[]
  publisherMemberships  PublisherMember[]
  publicationMemberships PublicationMember[]
  publicationSubscriptions PublicationSubscription[]
  publicationAuditLogs  PublicationAuditLog[]

  // Administrative Staff & HRMS Relations
  staffProfile          StaffProfile?
  createdTasks          StaffTask[]           @relation("TaskCreator")
  assignedTasks         StaffTask[]           @relation("TaskAssignee")
  taskComments          StaffTaskComment[]
  requestedApprovals    StaffApproval[]       @relation("ApprovalRequester")
  reviewedApprovals     StaffApproval[]       @relation("ApprovalReviewer")
  headOfDepartments     Department[]          @relation("DepartmentHead")
  approvedLeaves        StaffLeaveRequest[]   @relation("LeaveApprover")

  // Shubban Ads Network Relations
  advertisersOwned      Advertiser[]          @relation("AdvertiserOwner")
  advertiserMemberships AdvertiserMember[]
  createdAdCampaigns    AdCampaign[]          @relation("CampaignCreator")
  approvedAdCampaigns   AdCampaign[]          @relation("CampaignApprover")
  approvedAdCreatives   AdCreative[]          @relation("CreativeApprover")
  adStaffAssignments   AdStaffAssignment[]   @relation("StaffAdAssignee")
  adAuditLogs           AdAuditLog[]          @relation("AdAuditActor")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([customerType])
}

model CustomerTag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  color       String   @default("#6B7280")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Author {
  id             String          @id @default(cuid())
  name           String
  nameEn         String?
  slug           String          @unique
  bio            String?
  bioDetails     String?
  photoUrl       String?
  designation    String?
  email          String?
  phone          String?
  expertise      String?
  workplace      String?
  education      String?
  experience     String?
  awards         String?
  facebook       String?
  linkedin       String?
  twitter        String?
  instagram      String?
  youtube        String?
  website        String?
  status         String          @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT, PENDING_REVIEW
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  isVerified     Boolean         @default(false)
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  books          Book[]
  articles       Article[]
  papers         ResearchPaper[]

  @@index([slug])
  @@index([status])
  @@index([isActive])
}

model Publisher {
  id                 String     @id @default(cuid())
  name               String
  nameEn             String?
  slug               String     @unique
  logoUrl            String?
  publisherType      String?    @default("COMMERCIAL") // COMMERCIAL, ISLAMIC_FOUNDATION, ACADEMIC_PRESS, GOVERNMENT, INDEPENDENT
  description        String?
  descriptionDetails String?
  contactPerson      String?
  email              String?
  phone              String?
  altPhone           String?
  website            String?
  country            String?    @default("বাংলাদেশ")
  division           String?
  city               String?
  postalCode         String?
  address            String?
  regNumber          String?
  binNumber          String?
  establishedYear    Int?
  organizationType   String?    @default("LIMITED") // LIMITED, PROPRIETORSHIP, TRUST, SOCIETY, NGO
  mainCategory       String?
  specialization     String?
  facebook           String?
  linkedin           String?
  twitter            String?
  instagram          String?
  youtube            String?
  status             String     @default("ACTIVE") // ACTIVE, INACTIVE, PENDING_VERIFICATION, SUSPENDED
  isActive           Boolean    @default(true)
  isVerified         Boolean    @default(false)
  isFeatured         Boolean    @default(false)
  seoTitle           String?
  seoDescription     String?
  ogImage            String?
  userId             String?    @unique
  user               User?      @relation(fields: [userId], references: [id])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  books              Book[]
  magazines          Magazine[]
  members            PublisherMember[]
  auditLogs          PublicationAuditLog[]

  @@index([slug])
  @@index([status])
  @@index([isActive])
  @@index([isVerified])
}

model Category {
  id             String     @id @default(cuid())
  name           String
  nameEn         String?
  slug           String     @unique
  description    String?
  icon           String?
  image          String?
  type           String     @default("BOOK") // BOOK, ARTICLE, MAGAZINE, RESEARCH, QUESTION
  parentId       String?
  isActive       Boolean    @default(true)
  displayOrder   Int        @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  books          Book[]
  articles       Article[]
  magazines      Magazine[]
  questions      Question[]

  @@index([slug])
  @@index([type])
  @@index([parentId])
  @@index([isActive])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
}

model Book {
  id              String      @id @default(cuid())
  title           String
  titleEn         String?
  slug            String      @unique
  isbn            String?
  edition         String?
  language        String      @default("bn") // bn, en
  pages           Int?
  bindingType     String?     // Hardcover, Paperback
  description     String
  synopsis        String?
  toc             String?     // Table of Contents
  price           Float       // Physical book price
  discountPrice   Float?
  stockQuantity   Int         @default(10)
  isPhysicalAvailable Boolean @default(true)
  isDigitalAvailable  Boolean @default(false)
  isFree          Boolean     @default(false)
  coverImage      String
  samplePdfUrl    String?
  fullPdfUrl      String?
  pdfFileSize     String?
  authorId        String
  author          Author      @relation(fields: [authorId], references: [id])
  publisherId     String?
  publisher       Publisher?  @relation(fields: [publisherId], references: [id])
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  vendorId        String?
  vendor          Vendor?     @relation(fields: [vendorId], references: [id])
  isFeatured      Boolean     @default(false)
  isNewArrival    Boolean     @default(true)
  isBestSeller    Boolean     @default(false)
  isEditorsPick   Boolean     @default(false)
  publishedYear   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems      OrderItem[]
  reviews         Review[]
  bookmarks       Bookmark[]
  readingProgress ReadingProgress[]
  entitlements    DigitalEntitlement[]
  variants        ProductVariant[]
  attributeAssignments ProductAttributeAssignment[]
  vendorProducts  VendorProduct[]
  returnItems     ReturnItem[]

  @@index([categoryId])
  @@index([authorId])
  @@index([publisherId])
  @@index([vendorId])
  @@index([isFeatured, createdAt])
  @@index([isNewArrival, createdAt])
  @@index([isBestSeller, createdAt])
  @@index([isFree, isDigitalAvailable])
  @@index([price])
  @@index([stockQuantity])
}

model Magazine {
  id               String             @id @default(cuid())
  title            String
  titleEn          String?
  slug             String             @unique
  frequency        String             @default("MONTHLY") // WEEKLY, MONTHLY, QUARTERLY, ANNUAL
  description      String
  coverImage       String
  editor           String?
  editorialMessage String?
  month            String?
  year             Int?
  volume           String?
  issueNumber      String?
  language         String?            @default("bn") // bn, ar, en
  tags             String?
  seoTitle         String?
  metaDescription  String?
  status           String             @default("PUBLISHED") // DRAFT, PUBLISHED, SCHEDULED, ARCHIVED
  publisherId      String?
  publisher        Publisher?         @relation(fields: [publisherId], references: [id])
  categoryId       String
  category         Category           @relation(fields: [categoryId], references: [id])
  isFeatured       Boolean            @default(false)
  themeColor       String?            @default("#c59b27")
  logoUrl          String?
  bannerUrl        String?
  subdomain        String?
  website          String?
  email            String?
  phone            String?
  establishedYear  Int?
  isSubscribable   Boolean            @default(false)
  singleIssuePrice Float              @default(0)
  monthlySubscriptionPrice Float      @default(0)
  annualSubscriptionPrice Float       @default(0)
  totalSubscribers Int                @default(0)
  totalRevenue     Float              @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  issues            PublicationIssue[]
  articles          Article[]
  members           PublicationMember[]
  schedule          PublicationSchedule?
  subscriptionPlans PublicationSubscriptionPlan[]
  subscriptions     PublicationSubscription[]
  rights            PublicationRights[]
  auditLogs         PublicationAuditLog[]
  magazineSettings  MagazineSetting[]

  @@index([slug])
  @@index([categoryId])
  @@index([status])
}

model PublicationIssue {
  id               String    @id @default(cuid())
  magazineId       String
  magazine         Magazine  @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  issueTitle       String
  volume           String?
  issueNumber      String?
  publicationDate  DateTime
  coverImage       String
  pdfUrl           String
  fileSize         String?
  pageCount        Int       @default(0)
  summary          String?
  toc              String?
  authorizedPdfUrl String?
  allowDownload    Boolean   @default(true)
  allowShare       Boolean   @default(true)
  readOnline       Boolean   @default(true)
  requireLogin     Boolean   @default(false)
  status           String    @default("PUBLISHED") // DRAFT, PUBLISHED, SCHEDULED, ARCHIVED
  editorNotes      String?
  approvedBy       String?
  approvedAt       DateTime?
  downloads        Int       @default(0)
  views            Int       @default(0)
  isFree           Boolean   @default(false)
  price            Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  articles         Article[]
  entitlements     DigitalEntitlement[]
  readingSessions  ReadingSession[]
  downloadsLog     PublicationDownload[]
  sharesLog        PublicationShare[]
  readingProgress  IssueReadingProgress[]
  rights           PublicationRights[]

  @@index([magazineId])
  @@index([publicationDate])
  @@index([status])
}

model Article {
  id                String            @id @default(cuid())
  title             String
  subtitle          String?
  slug              String            @unique
  content           String
  excerpt           String
  coverImage        String?
  type              String            @default("ESSAY") // ISLAMIC_ARTICLE, ESSAY, EDITORIAL, RESEARCH_PAPER, ISLAMIC_HISTORY, QURAN_HADITH_RESEARCH, BOOK_REVIEW, INTERVIEW, EDUCATIONAL, MAGAZINE_ARTICLE
  status            String            @default("PUBLISHED") // DRAFT, REVIEW, SCHEDULED, PUBLISHED, ARCHIVED
  authorId          String
  author            Author            @relation(fields: [authorId], references: [id])
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id])
  issueId           String?
  issue             PublicationIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)
  magazineId        String?
  magazine          Magazine?         @relation(fields: [magazineId], references: [id], onDelete: SetNull)
  editorialStatus   String            @default("PUBLISHED") // DRAFT, IN_REVIEW, REVISION_REQUESTED, APPROVED, PUBLISHED, REJECTED
  reviewedBy        String?
  reviewNotes       String?
  version           Int               @default(1)
  footnotes         String?           // JSON string of structured footnotes / scholarly citations
  isFree            Boolean           @default(true)
  price             Float             @default(0)
  readingTime       Int               @default(5) // in minutes
  views             Int               @default(0)
  isFeatured        Boolean           @default(false)
  tags              String?
  arabicContent     String?
  references        String?
  relatedBookIds    String?           // JSON array of book IDs
  relatedArticleIds String?           // JSON array of article IDs
  metaTitle         String?
  metaDescription   String?
  canonicalUrl      String?
  scheduledAt       DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  publishedAt       DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  comments          Comment[]
  bookmarks         Bookmark[]
  readingSessions   ReadingSession[]
  downloadsLog      PublicationDownload[]
  sharesLog         PublicationShare[]

  @@index([authorId])
  @@index([categoryId])
  @@index([issueId])
  @@index([magazineId])
  @@index([status])
  @@index([editorialStatus])
  @@index([type])
  @@index([publishedAt])
}

model ReadingSession {
  id                 String            @id @default(cuid())
  issueId            String?
  issue              PublicationIssue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
  articleId          String?
  article            Article?          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId          String
  ipHash             String?
  deviceType         String?           @default("desktop") // mobile, tablet, desktop
  browser            String?
  os                 String?
  pagesRead          String?           // JSON array of page numbers viewed
  totalPagesViewed   Int               @default(1)
  lastPage           Int               @default(1)
  durationSeconds    Int               @default(0)
  isMeaningfulReader Boolean           @default(false) // duration >= 30s OR totalPagesViewed >= 3
  completionRate     Float             @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([issueId])
  @@index([articleId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([isMeaningfulReader])
}

model PublicationDownload {
  id        String            @id @default(cuid())
  issueId   String?
  issue     PublicationIssue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article?          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipHash    String?
  fileType  String            @default("PDF")
  fileSize  String?
  createdAt DateTime          @default(now())

  @@index([issueId])
  @@index([articleId])
  @@index([createdAt])
}

model PublicationShare {
  id        String            @id @default(cuid())
  issueId   String?
  issue     PublicationIssue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article?          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform  String            // FACEBOOK, WHATSAPP, TWITTER, COPY_LINK, NATIVE
  createdAt DateTime          @default(now())

  @@index([issueId])
  @@index([articleId])
  @@index([platform])
  @@index([createdAt])
}

model IssueReadingProgress {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  issueId     String
  issue       PublicationIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  currentPage Int              @default(1)
  totalPages  Int              @default(1)
  lastReadAt  DateTime         @default(now())

  @@unique([userId, issueId])
  @@index([userId])
  @@index([issueId])
}

model PublicationFile {
  id            String    @id @default(cuid())
  fileName      String
  fileUrl       String
  fileSize      String?
  fileSizeBytes Int       @default(0)
  mimeType      String    @default("application/pdf")
  pageCount     Int       @default(0)
  title         String?
  storageType   String    @default("LOCAL") // LOCAL, CLOUD, S3
  isRestricted  Boolean   @default(false)
  magazineId    String?
  publisherId   String?
  checksum      String?
  uploadedBy    String?
  downloads     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([fileName])
  @@index([storageType])
  @@index([magazineId])
  @@index([createdAt])
}

model PublicationTag {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  color       String?   @default("#c59b27")
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([slug])
}

model PublicationSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model MagazineSetting {
  id          String   @id @default(cuid())
  magazineId  String
  magazine    Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  key         String
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([magazineId, key])
  @@index([magazineId])
}

model PublisherMember {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // OWNER, ADMIN, EDITOR, MEMBER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([publisherId, userId])
  @@index([publisherId])
  @@index([userId])
}

model PublicationMember {
  id          String   @id @default(cuid())
  magazineId  String
  magazine    Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("AUTHOR") // PUBLICATION_ADMIN, EDITOR_IN_CHIEF, MANAGING_EDITOR, SECTION_EDITOR, AUTHOR, REVIEWER, PROOFREADER, TRANSLATOR, DESIGNER, CONTRIBUTOR, ANALYST
  permissions String?  // JSON string of granular custom permissions
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([magazineId, userId])
  @@index([magazineId])
  @@index([userId])
  @@index([role])
}

model PublicationSchedule {
  id                    String    @id @default(cuid())
  magazineId            String    @unique
  magazine              Magazine  @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  frequency             String    @default("MONTHLY") // DAILY, WEEKLY, FORTNIGHTLY, MONTHLY, BIMONTHLY, QUARTERLY, HALFYEARLY, ANNUAL, SPECIAL_EDITION, IRREGULAR, CUSTOM
  expectedDay           Int?
  expectedMonth         Int?
  nextExpectedDate      DateTime?
  editorialDeadlineDays Int       @default(7)
  numberingScheme       String    @default("VOL_ISSUE") // VOL_ISSUE, CONTINUOUS_ISSUE, YEAR_MONTH, HIJRI_YEAR
  timeZone              String    @default("Asia/Dhaka")
  autoReminders         Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([frequency])
  @@index([nextExpectedDate])
}

model PublicationRights {
  id                     String            @id @default(cuid())
  magazineId             String?
  magazine               Magazine?         @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  issueId                String?
  issue                  PublicationIssue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
  rightsHolder           String
  publisher              String?
  licenseType            String            @default("ALL_RIGHTS_RESERVED") // ALL_RIGHTS_RESERVED, CREATIVE_COMMONS, OPEN_ACCESS, AUTHOR_PERMISSION, PUBLIC_DOMAIN
  copyrightNotice        String?
  allowPdfHosting        Boolean           @default(true)
  allowArticleDisplay    Boolean           @default(true)
  allowDownloads         Boolean           @default(true)
  attributionRequirement String?
  territory              String            @default("GLOBAL")
  licenseStartDate       DateTime?
  licenseEndDate         DateTime?
  authorizationProofUrl  String?
  takedownStatus         String            @default("ACTIVE") // ACTIVE, SUSPENDED, TAKEN_DOWN, UNDER_REVIEW
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([magazineId])
  @@index([issueId])
  @@index([takedownStatus])
}

model PublicationAuditLog {
  id          String     @id @default(cuid())
  magazineId  String?
  magazine    Magazine?  @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  publisherId String?
  publisher   Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?
  action      String     // CREATE, UPDATE, DELETE, PUBLISH, UNPUBLISH, APPROVE, REJECT, OVERRIDE, PERMISSION_CHANGE
  targetType  String     // MAGAZINE, ISSUE, ARTICLE, FILE, MEMBER, SETTING, RIGHTS
  targetId    String?
  details     String?    // JSON string
  ipHash      String?
  createdAt   DateTime   @default(now())

  @@index([magazineId])
  @@index([publisherId])
  @@index([userId])
  @@index([targetType])
  @@index([action])
  @@index([createdAt])
}

model PublicationSubscriptionPlan {
  id                 String                    @id @default(cuid())
  magazineId         String?
  magazine           Magazine?                 @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  publisherId        String?
  name               String
  slug               String                    @unique
  description        String?
  durationMonths     Int                       @default(1) // 1 = Monthly, 3 = Quarterly, 6 = Half-Yearly, 12 = Annual
  price              Float
  originalPrice      Float?
  isActive           Boolean                   @default(true)
  isFeatured         Boolean                   @default(false)
  features           String?                   // JSON string
  allowDownloads     Boolean                   @default(true)
  allowArchiveAccess Boolean                   @default(true)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  subscriptions      PublicationSubscription[]

  @@index([magazineId])
  @@index([isActive])
}

model PublicationSubscription {
  id            String                      @id @default(cuid())
  userId        String
  user          User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String
  plan          PublicationSubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  magazineId    String?
  magazine      Magazine?                   @relation(fields: [magazineId], references: [id], onDelete: SetNull)
  publisherId   String?
  status        String                      @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED, PENDING_PAYMENT, GRACE_PERIOD
  startDate     DateTime                    @default(now())
  endDate       DateTime
  autoRenew     Boolean                     @default(false)
  amountPaid    Float
  paymentMethod String?                     // BKASH, NAGAD, SSLCOMMERZ, MANUAL
  transactionId String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([magazineId])
  @@index([status])
}

model ResearchPaper {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  abstract      String
  content       String?
  pdfUrl        String?
  doi           String?
  institution   String?
  field         String?   // Literature, History, Philosophy, Social Science, Islamic Studies
  authorId      String
  author        Author    @relation(fields: [authorId], references: [id])
  citationText  String?
  downloads     Int       @default(0)
  isFeatured    Boolean   @default(false)
  publishedDate DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Presentation {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  presenter   String
  institution String?
  fileUrl     String
  fileType    String   @default("PDF") // PDF, PPTX
  slidesCount Int      @default(20)
  isFeatured  Boolean  @default(false)
  eventDate   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Question {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  views       Int      @default(0)
  isClosed    Boolean  @default(false)
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  answers     Answer[]
  votes       Vote[]
}

model Answer {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  content     String
  isAccepted  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  votes       Vote[]
}

model Vote {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  questionId String?
  question   Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId   String?
  answer     Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  voteType   Int       // 1 for upvote, -1 for downvote
  createdAt  DateTime  @default(now())

  @@unique([userId, questionId, answerId])
}

model Review {
  id        String   @id @default(cuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      // 1 to 5
  comment   String?
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  isApproved Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String?
  book      Book?    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  page      Int?
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, bookId, articleId, page])
}

model ReadingProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  currentPage Int      @default(1)
  totalPages  Int      @default(100)
  percentage  Float    @default(0)
  lastReadAt  DateTime @default(now())

  @@unique([userId, bookId])
}

model DigitalEntitlement {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String?
  book      Book?             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  issueId   String?
  issue     PublicationIssue? @relation(fields: [issueId], references: [id], onDelete: Cascade)
  type      String            @default("PURCHASE") // PURCHASE, SUBSCRIPTION, FREE_GRANT
  grantedAt DateTime          @default(now())
  expiresAt DateTime?

  @@unique([userId, bookId, issueId])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  subtotal       Float
  shippingFee    Float       @default(0)
  discount       Float       @default(0)
  total          Float
  paymentStatus  String      @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  orderStatus    String      @default("PROCESSING") // PROCESSING, PACKED, SHIPPED, DELIVERED, CANCELLED
  paymentMethod  String      // bkash, nagad, sslcommerz, cod, bank
  transactionId  String?
  shippingName   String
  shippingPhone  String
  shippingAddress String
  shippingCity   String
  trackingNumber String?
  courierName    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  isGiftWrapped  Boolean     @default(false)
  giftMessage    String?
  giftWrapFee    Float       @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items          OrderItem[]
  subOrders      SubOrder[]
  refunds        Refund[]
  reservations   StockReservation[]
  shipments      Shipment[]
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id])
  variantId  String?
  type       String   @default("PHYSICAL") // PHYSICAL, DIGITAL
  quantity   Int      @default(1)
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([bookId])
}

model MembershipPlan {
  id          String   @id @default(cuid())
  name        String
  nameEn      String
  code        String   @unique // FREE, DIGITAL, PREMIUM, INSTITUTIONAL
  description String
  priceMonthly Float
  priceYearly  Float
  features    String   // JSON string of feature list
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        MembershipPlan @relation(fields: [planId], references: [id])
  interval    String         @default("MONTHLY") // MONTHLY, YEARLY
  status      String         @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  startDate   DateTime       @default(now())
  endDate     DateTime
  paymentMethod String       @default("bkash")
  transactionId String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Submission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String   // BOOK, ARTICLE, RESEARCH, MAGAZINE
  title       String
  category    String
  description String
  fileUrl     String?
  status      String   @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, REVISION_REQUESTED, APPROVED, REJECTED, PUBLISHED
  reviewNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  type      String   @default("SYSTEM") // SYSTEM, ORDER, COMMENT, QNA, SUBSCRIPTION
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  discountPct Float?
  discountAmt Float?
  minAmount   Float?
  maxUsage    Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

// ==========================================
// MULTI-VENDOR MARKETPLACE & COMMERCE MODELS
// ==========================================

model Vendor {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  legalName           String?
  description         String?
  logoUrl             String?
  bannerUrl           String?
  email               String   @unique
  phone               String
  address             String
  city                String
  nidOrTradeLicense   String?
  bankName            String?
  bankAccountName     String?
  bankAccountNumber   String?
  bankRoutingNumber   String?
  bkashMerchantNumber String?
  rating              Float    @default(5.0)
  ratingCount         Int      @default(0)
  commissionRate      Float?   // Custom commission override if different from platform default
  status              String   @default("APPROVED") // PENDING, APPROVED, SUSPENDED, REJECTED
  isVerified          Boolean  @default(true)
  isFeatured          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members             VendorMember[]
  books               Book[]
  vendorProducts      VendorProduct[]
  subOrders           SubOrder[]
  ledgerEntries       SellerLedgerEntry[]
  payouts             SellerPayout[]
}

model VendorMember {
  id        String   @id @default(cuid())
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("OWNER") // OWNER, MANAGER, STAFF
  createdAt DateTime @default(now())

  @@unique([vendorId, userId])
}

model VendorApplication {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  shopName        String
  shopSlug        String
  ownerName       String
  phone           String
  email           String
  businessAddress String
  city            String
  businessType    String   // BOOKSTORE, PUBLISHER, ISLAMIC_LIFESTYLE, GENERAL
  tradeLicense    String?
  nidNumber       String?
  description     String?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNotes      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model VendorProduct {
  id            String   @id @default(cuid())
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  bookId        String
  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  price         Float
  discountPrice Float?
  stockQuantity Int      @default(10)
  condition     String   @default("NEW") // NEW, USED_LIKE_NEW, RARE
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([vendorId, bookId])
}

model ProductVariant {
  id                String    @id @default(cuid())
  bookId            String
  book              Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name              String    // e.g. "৬ মিলি বোতল", "১২ মিলি সুবাস", "Size: L / Color: Red"
  sku               String?   @unique
  barcode           String?
  price             Float
  salePrice         Float?
  costPrice         Float?
  wholesalePrice    Float?
  stockQuantity     Int       @default(10)
  lowStockThreshold Int       @default(5)
  manageStock       Boolean   @default(true)
  stockStatus       String    @default("IN_STOCK") // IN_STOCK, OUT_OF_STOCK, BACKORDER
  allowBackorders   Boolean   @default(false)
  image             String?
  gallery           String?   // JSON array of image URLs
  description       String?
  weight            Float?    // in grams or kg
  length            Float?
  width             Float?
  height            Float?
  shippingClass     String?
  taxClass          String?
  status            String    @default("ACTIVE") // ACTIVE, INACTIVE
  attributes        String?   // JSON string e.g. {"volume": "6ml", "color": "Amber"} or {"Size": "L", "Color": "Red"}
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([bookId])
  @@index([status])
  @@index([stockStatus])
}

model ProductAttributeGroup {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  description  String?
  displayOrder Int                @default(0)
  status       String             @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  attributes   ProductAttribute[]

  @@index([status])
  @@index([displayOrder])
}

model ProductAttribute {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  code          String             @unique
  description   String?
  type          String             @default("SELECT") // SELECT, MULTI_SELECT, RADIO, CHECKBOX, COLOR_SWATCH, IMAGE_SWATCH, TEXT, NUMBER, BUTTON
  displayLabel  String?
  displayOrder  Int                @default(0)
  status        String             @default("ACTIVE") // ACTIVE, INACTIVE
  isRequired    Boolean            @default(false)
  isVariant     Boolean            @default(true) // Whether used for variant generation
  showOnProduct Boolean            @default(true) // Show on product specifications
  useInFilter   Boolean            @default(true) // Use in product filters
  
  groupId       String?
  group         ProductAttributeGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt

  values        ProductAttributeValue[]
  assignments   ProductAttributeAssignment[]

  @@index([groupId])
  @@index([type])
  @@index([status])
  @@index([displayOrder])
}

model ProductAttributeValue {
  id           String             @id @default(cuid())
  attributeId  String
  attribute    ProductAttribute   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  code         String?
  colorHex     String?            // e.g. #FF0000
  swatchImage  String?            // Image URL for image swatch
  displayOrder Int                @default(0)
  status       String             @default("ACTIVE") // ACTIVE, INACTIVE
  metadata     String?            // JSON string for extra custom metadata
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  assignmentValues ProductAttributeAssignmentValue[]

  @@unique([attributeId, slug])
  @@unique([attributeId, name])
  @@index([attributeId])
  @@index([status])
  @@index([displayOrder])
}

model ProductAttributeAssignment {
  id           String             @id @default(cuid())
  bookId       String
  book         Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  attributeId  String
  attribute    ProductAttribute   @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  isRequired   Boolean            @default(false)
  isVariant    Boolean            @default(false) // Used as variant-generating on this product
  defaultValue String?
  displayOrder Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  values       ProductAttributeAssignmentValue[]

  @@unique([bookId, attributeId])
  @@index([bookId])
  @@index([attributeId])
}

model ProductAttributeAssignmentValue {
  id           String                     @id @default(cuid())
  assignmentId String
  assignment   ProductAttributeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  valueId      String
  value        ProductAttributeValue      @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, valueId])
  @@index([assignmentId])
  @@index([valueId])
}

model SubOrder {
  id             String      @id @default(cuid())
  subOrderNumber String      @unique
  orderId        String
  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor      @relation(fields: [vendorId], references: [id])
  subtotal       Float
  shippingFee    Float       @default(0)
  commissionRate Float       @default(10.0) // Commission % charged by platform
  commissionAmt  Float       @default(0)    // Platform commission earned
  payoutAmt      Float       @default(0)    // Net payable to seller
  status         String      @default("PROCESSING") // PROCESSING, PACKED, SHIPPED, DELIVERED, CANCELLED
  courierName    String?     // Pathao, RedX, Steadfast, eCourier, Paperfly
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  items          SubOrderItem[]
  shipments      Shipment[]
  returnRequests ReturnRequest[]

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

model SubOrderItem {
  id         String   @id @default(cuid())
  subOrderId String
  subOrder   SubOrder @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  bookId     String
  title      String
  coverImage String
  price      Float
  quantity   Int
  total      Float
  createdAt  DateTime @default(now())

  @@index([subOrderId])
  @@index([bookId])
}

model CommissionRule {
  id           String   @id @default(cuid())
  name         String
  categorySlug String?  @unique // if applies to specific category, null for global
  vendorId     String?  // if applies to specific vendor
  percentage   Float    // e.g. 10.0 for 10%
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model SellerLedgerEntry {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  subOrderId   String?
  payoutId     String?
  type         String   // ORDER_CREDIT, COMMISSION_DEBIT, PAYOUT_DEBIT, REFUND_ADJUSTMENT
  amount       Float
  balanceAfter Float
  description  String
  createdAt    DateTime @default(now())

  @@index([vendorId])
  @@index([type])
  @@index([createdAt])
}

model SellerPayout {
  id              String    @id @default(cuid())
  payoutNumber    String    @unique
  vendorId        String
  vendor          Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  amount          Float
  method          String    // BANK_TRANSFER, BKASH_MERCHANT, NAGAD
  accountDetails  String
  status          String    @default("REQUESTED") // REQUESTED, APPROVED, PROCESSING, PAID, REJECTED, REVERSED
  transactionRef  String?
  requestedBy     String?   // Maker ID
  approvedBy      String?   // Checker ID
  processedBy     String?   // Disburser ID
  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  processedAt     DateTime?
  rejectionReason String?
  notes           String?

  @@index([vendorId])
  @@index([status])
  @@index([requestedAt])
}

// ==========================================
// AS-SUNNAH INSPIRED DONATION MODELS
// ==========================================

model DonationCampaign {
  id           String   @id @default(cuid())
  title        String
  titleEn      String?
  slug         String   @unique
  category     String   // RELIEF, QURAN_DISTRIBUTION, WINTER_AID, WATER_WELL, MOSQUE, EDUCATION, GENERAL_SADAQAH
  description  String
  story        String?  // Rich content / full case story
  coverImage   String
  goalAmount   Float
  raisedAmount Float    @default(0)
  donorCount   Int      @default(0)
  status       String   @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  startDate    DateTime @default(now())
  endDate      DateTime?
  isFeatured   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  donations    Donation[]
}

model Donation {
  id             String            @id @default(cuid())
  donationNumber String            @unique
  campaignId     String
  campaign       DonationCampaign  @relation(fields: [campaignId], references: [id])
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  donorName      String
  donorEmail     String?
  donorPhone     String?
  isAnonymous    Boolean           @default(false)
  amount         Float
  paymentMethod  String            // bkash, nagad, sslcommerz, bank
  transactionId  String?
  paymentStatus  String            @default("PAID") // PENDING, PAID, FAILED
  receiptNumber  String            @unique
  refundStatus   String?           // NONE, REFUNDED
  refundedAt     DateTime?
  refundReason   String?
  notes          String?
  createdAt      DateTime          @default(now())

  receipt        DonationReceipt?

  @@index([campaignId])
  @@index([userId])
  @@index([paymentStatus])
  @@index([createdAt])
}

model DonationReceipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  donationId    String   @unique
  donation      Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  donorName     String
  campaignTitle String
  amount        Float
  paymentMethod String
  transactionId String?
  issuedAt      DateTime @default(now())
  taxExemptInfo String?  @default("শুব্বান ওয়েলফেয়ার ট্রাস্ট ও আস-সুন্নাহ সদকাহ ফান্ড স্বীকৃত")
}

// ==========================================
// INVENTORY AUDIT & PAYMENT TRANSACTION LOGS
// ==========================================

model InventoryLog {
  id             String   @id @default(cuid())
  bookId         String
  variantId      String?
  vendorId       String?
  changeType     String   // ORDER_FULFILLMENT, RESTOCK, RETURN, DAMAGE_WRITE_OFF, MANUAL_ADJUSTMENT
  quantityChange Int
  balanceAfter   Int
  referenceId    String?  // Order/SubOrder number
  reason         String?
  createdAt      DateTime @default(now())

  @@index([bookId])
  @@index([createdAt])
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  orderId         String?
  donationId      String?
  gateway         String   // BKASH, NAGAD, SSLCOMMERZ, COD, BANK_TRANSFER
  amount          Float
  currency        String   @default("BDT")
  transactionId   String   @unique
  status          String   @default("INITIATED") // INITIATED, SUCCESS, FAILED, CANCELLED, REFUNDED
  gatewayResponse String?  // JSON stringified raw gateway callback
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  refunds         Refund[]

  @@index([orderId])
  @@index([donationId])
  @@index([status])
  @@index([createdAt])
}

model SupportTicket {
  id           String           @id @default(cuid())
  ticketNumber String           @unique
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  subject      String
  category     String           @default("GENERAL") // ORDER, PAYMENT, RETURN, BOOK_INQUIRY, TECHNICAL, GENERAL
  priority     String           @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  status       String           @default("OPEN")    // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  message      String
  orderId      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  responses    TicketResponse[]
}

model TicketResponse {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  message   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String   @default("বাসার ঠিকানা") // Home, Office, Other
  name         String
  phone        String
  address      String
  city         String   @default("ঢাকা")
  zone         String   @default("DHAKA_METRO") // DHAKA_METRO, OUTSIDE_DHAKA
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model Refund {
  id                   String              @id @default(cuid())
  orderId              String
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentTransactionId String?
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id])
  amount               Float
  reason               String
  status               String              @default("PENDING") // PENDING, PROCESSED, REJECTED
  refundTxnId          String?             @unique
  adminNote            String?
  processedAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  returnRequests       ReturnRequest[]

  @@index([orderId])
  @@index([status])
}

model StockReservation {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookId    String
  variantId String?
  quantity  Int
  status    String   @default("ACTIVE") // ACTIVE, FULFILLED, RELEASED, EXPIRED
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([bookId])
  @@index([orderId])
  @@index([status])
}

// ==========================================
// SHIPPING & LOGISTICS MODELS
// ==========================================

model ShippingZone {
  id              String           @id @default(cuid())
  name            String           // "ঢাকা মেট্রো", "ঢাকা উপশহর", "ঢাকার বাইরে", "পার্বত্য ও প্রত্যন্ত অঞ্চল"
  code            String           @unique // DHAKA_METRO, DHAKA_SUBURBS, OUTSIDE_DHAKA, REMOTE
  rate            Float            // Base delivery fee (e.g. 60, 90, 120, 150)
  estimatedDays   String           // "১-২ দিন", "২-৩ দিন", "৩-৫ দিন"
  freeDeliveryMin Float?           // Minimum cart total for free delivery, e.g. 1000
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  methods         ShippingMethod[]
  rates           ShippingRate[]
}

model ShippingMethod {
  id             String       @id @default(cuid())
  zoneId         String
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name           String       // "স্ট্যান্ডার্ড হোম ডেলিভারি", "এক্সপ্রেস ২৪ ঘণ্টা"
  code           String       // STANDARD, EXPRESS, SAME_DAY
  baseCharge     Float
  perKgExtra     Float        @default(20.0)
  courierPartner String       // Pathao, Steadfast, RedX, eCourier, Paperfly
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model CourierProvider {
  id                        String              @id @default(cuid())
  code                      String              @unique // PATHAO, STEADFAST, REDX
  name                      String              // "Pathao Courier", "Steadfast Courier", "REDX Delivery"
  logoUrl                   String?
  isEnabled                 Boolean             @default(false)
  isDefault                 Boolean             @default(false)
  status                    String              @default("PENDING_CONFIG") // ACTIVE, PENDING_CONFIG, ERROR, DISABLED
  apiBaseUrl                String
  webhookUrl                String?
  apiKey                    String?
  apiSecret                 String?
  clientId                  String?
  clientSecret              String?
  username                  String?
  password                  String?
  storeId                   String?
  isCodSupported            Boolean             @default(true)
  autoBookingEnabled        Boolean             @default(false)
  defaultChargeInsideDhaka  Float               @default(60.0)
  defaultChargeOutsideDhaka Float               @default(120.0)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt

  shipments                 Shipment[]
  webhookLogs               CourierWebhookLog[]
  settings                  CourierSetting[]
}

model CourierSetting {
  id          String          @id @default(cuid())
  providerId  String
  provider    CourierProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  key         String
  value       String
  isEncrypted Boolean         @default(false)

  @@unique([providerId, key])
}

model ShippingRate {
  id                 String        @id @default(cuid())
  zoneId             String?
  zone               ShippingZone? @relation(fields: [zoneId], references: [id])
  providerCode       String?       // PATHAO, STEADFAST, REDX or ALL
  name               String
  destinationType    String        // INSIDE_DHAKA, SUB_DHAKA, OUTSIDE_DHAKA, DISTRICT, UPAZILA
  district           String?
  upazila            String?
  baseWeightKg       Float         @default(1.0)
  baseRate           Float         @default(60.0)
  perKgExtraRate     Float         @default(20.0)
  codChargePct       Float         @default(1.0) // percentage, e.g. 1.0%
  codChargeFixed     Float         @default(0.0)
  specialDeliveryFee Float         @default(0.0)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([destinationType])
  @@index([district])
}

model Shipment {
  id              String             @id @default(cuid())
  shipmentNumber  String             @unique // e.g. "SHP-2026-XXXXX"
  orderId         String
  order           Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId      String?
  subOrder        SubOrder?          @relation(fields: [subOrderId], references: [id])
  providerId      String?
  provider        CourierProvider?   @relation(fields: [providerId], references: [id])
  settlementId    String?
  settlement      CodSettlement?     @relation(fields: [settlementId], references: [id])
  courierCode     String             // PATHAO, STEADFAST, REDX, ECOURIER, PAPERFLY
  courierName     String             // "Pathao Courier", "Steadfast Courier"
  trackingNumber  String?            // Courier tracking number or Consignment ID
  consignmentId   String?
  status          String             @default("PENDING_PICKUP") // PENDING_PICKUP, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, RETURNED, FAILED, CANCELLED
  shippingAddress String
  shippingPhone   String
  recipientName   String
  weightKg        Float              @default(1.0)
  codAmount       Float              @default(0) // COD amount to collect from customer
  codCollected    Float              @default(0) // Actual amount collected
  courierFee      Float              @default(0) // Delivery fee charged by courier
  netRemittance   Float              @default(0) // codCollected - courierFee remitted to platform
  isRemitted      Boolean            @default(false) // Whether courier settled COD remittance
  remittedAt      DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  labelPrintedAt  DateTime?
  invoicePrintedAt DateTime?
  deliveryTimeline String?           // JSON array string of checkpoints
  failedReason    String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  events          ShipmentEvent[]
  webhookLogs     CourierWebhookLog[]

  @@index([orderId])
  @@index([status])
  @@index([trackingNumber])
  @@index([consignmentId])
}

model ShipmentEvent {
  id            String   @id @default(cuid())
  shipmentId    String
  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status        String
  courierStatus String?
  location      String?
  note          String?
  timestamp     DateTime @default(now())

  @@index([shipmentId])
}

model CourierWebhookLog {
  id              String           @id @default(cuid())
  providerCode    String
  providerId      String?
  provider        CourierProvider? @relation(fields: [providerId], references: [id])
  event           String
  consignmentId   String?
  trackingNumber  String?
  shipmentId      String?
  shipment        Shipment?        @relation(fields: [shipmentId], references: [id])
  payload         String           // JSON string of webhook body
  signature       String?
  isVerified      Boolean          @default(false)
  processedStatus String           @default("PENDING") // PROCESSED, FAILED, IGNORED, DUPLICATE
  errorMessage    String?
  createdAt       DateTime         @default(now())

  @@index([providerCode, event])
  @@index([consignmentId])
  @@index([trackingNumber])
}

model CodSettlement {
  id                  String     @id @default(cuid())
  settlementNumber    String     @unique // e.g. "COD-SETTLE-2026-XXXXX"
  courierCode         String
  totalCodCollected   Float
  totalCourierCharges Float
  totalCodFees        Float      @default(0.0)
  netSettlementAmount Float
  receivedAmount      Float      @default(0)
  status              String     @default("PENDING") // PENDING, PARTIALLY_PAID, SETTLED, DISCREPANCY
  bankAccount         String?
  bankTxnReference    String?
  settledAt           DateTime?
  reconciledBy        String?
  notes               String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  shipments           Shipment[]

  @@index([courierCode])
  @@index([status])
}

model ReturnShipment {
  id              String        @id @default(cuid())
  returnRequestId String        @unique
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  courierCode     String
  trackingNumber  String?
  consignmentId   String?
  pickupAddress   String
  status          String        @default("BOOKED") // BOOKED, PICKED_UP, IN_TRANSIT, RECEIVED_AT_HUB, INSPECTED, COMPLETED
  shippingFee     Float         @default(0)
  feeBorneBy      String        @default("PLATFORM") // CUSTOMER, PLATFORM, VENDOR
  shippedAt       DateTime?
  receivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// ==========================================
// RETURNS, DISPUTES & RESTOCKING MODELS
// ==========================================

model ReturnRequest {
  id               String         @id @default(cuid())
  returnNumber     String         @unique // e.g. "RTN-2026-XXXXX"
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subOrderId       String?
  subOrder         SubOrder?      @relation(fields: [subOrderId], references: [id])
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  status           String         @default("REQUESTED") // REQUESTED, APPROVED, REJECTED, ITEM_RECEIVED, INSPECTED, REFUNDED, DISPUTED, CLOSED
  reason           String         // DEFECTIVE_PRINTING, WRONG_ITEM, DAMAGED_IN_TRANSIT, CHANGED_MIND, MISSING_PAGES
  explanation      String?
  customerImages   String?        // JSON array of image URLs
  approvedBy       String?        // Admin / Manager who approved
  approvedAt       DateTime?
  inspectionNotes  String?
  inspectionResult String?        // RESELLABLE, DAMAGED, REJECTED
  restocked        Boolean        @default(false)
  refundAmount     Float          @default(0)
  refundStatus     String         @default("PENDING") // PENDING, PROCESSED, REJECTED
  refundTxnId      String?
  refundId         String?
  refund           Refund?        @relation(fields: [refundId], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  items            ReturnItem[]
  disputes         ReturnDispute[]
  returnShipment   ReturnShipment?
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  bookId          String
  book            Book          @relation(fields: [bookId], references: [id])
  variantId       String?
  quantity        Int           @default(1)
  unitPrice       Float
  totalPrice      Float
  condition       String?       // INTACT, DAMAGED, DEFECTIVE
  restocked       Boolean       @default(false)
}

model ReturnDispute {
  id              String        @id @default(cuid())
  disputeNumber   String        @unique // e.g. "DSP-2026-XXXXX"
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  raisedByRole    String        // VENDOR, CUSTOMER, ADMIN
  raisedByUserId  String
  reason          String
  status          String        @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED_CUSTOMER_FAVOR, RESOLVED_VENDOR_FAVOR, REJECTED
  resolutionNotes String?
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

