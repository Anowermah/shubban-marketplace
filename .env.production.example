# ==============================================================================
# Shubban Library - Production Environment Variables Template
# ==============================================================================
# Copy this file to .env.production on your deployment server and fill in the secrets.
# NEVER commit raw passwords, tokens, or production API keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
# Canonical public URL of the marketplace (without trailing slash)
NEXT_PUBLIC_APP_URL="https://shubbanlibrary.com"
NEXTAUTH_URL="https://shubbanlibrary.com"

# NextAuth Encryption Secret (Generate with: openssl rand -hex 32)
NEXTAUTH_SECRET="REPLACE_WITH_SECURE_64_CHAR_HEX_SECRET_openssl_rand_hex_32"

# ------------------------------------------------------------------------------
# 2. PRODUCTION DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string to managed PostgreSQL instance (e.g. AWS RDS, DigitalOcean, Supabase)
DATABASE_URL="postgresql://shubban_admin:REPLACE_WITH_DB_PASSWORD@postgres:5432/shubban_production?schema=public&sslmode=prefer"
# For direct Prisma connection pool sizing
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25

# ------------------------------------------------------------------------------
# 3. BANGLADESH PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
# SSLCOMMERZ Hosted Checkout & IPN
SSLCOMMERZ_STORE_ID="shubban_live"
SSLCOMMERZ_STORE_PASS="REPLACE_WITH_SSLCOMMERZ_STORE_PASS"
SSLCOMMERZ_IS_LIVE="true" # Set "false" for sandbox/test mode
SSLCOMMERZ_API_URL="https://securepay.sslcommerz.com"

# bKash Payment Gateway (Tokenized API v1.2)
BKASH_APP_KEY="REPLACE_WITH_BKASH_APP_KEY"
BKASH_APP_SECRET="REPLACE_WITH_BKASH_APP_SECRET"
BKASH_USERNAME="REPLACE_WITH_BKASH_USERNAME"
BKASH_PASSWORD="REPLACE_WITH_BKASH_PASSWORD"
BKASH_IS_LIVE="true"

# Nagad Merchant Gateway (PGW)
NAGAD_MERCHANT_ID="REPLACE_WITH_NAGAD_MERCHANT_ID"
NAGAD_PUBLIC_KEY="REPLACE_WITH_NAGAD_PGW_PUBLIC_KEY"
NAGAD_PRIVATE_KEY="REPLACE_WITH_MERCHANT_PRIVATE_KEY"
NAGAD_IS_LIVE="true"

# ------------------------------------------------------------------------------
# 4. BANGLADESH COURIER & LOGISTICS GATEWAYS
# ------------------------------------------------------------------------------
# Pathao Courier API
PATHAO_CLIENT_ID="REPLACE_WITH_PATHAO_CLIENT_ID"
PATHAO_CLIENT_SECRET="REPLACE_WITH_PATHAO_CLIENT_SECRET"
PATHAO_USERNAME="REPLACE_WITH_PATHAO_ACCOUNT_EMAIL"
PATHAO_PASSWORD="REPLACE_WITH_PATHAO_ACCOUNT_PASS"
PATHAO_STORE_ID="REPLACE_WITH_PATHAO_STORE_ID"
PATHAO_BASE_URL="https://courier.pathao.com/aladdin/api/v1"

# Steadfast Courier API
STEADFAST_API_KEY="REPLACE_WITH_STEADFAST_API_KEY"
STEADFAST_SECRET_KEY="REPLACE_WITH_STEADFAST_SECRET_KEY"
STEADFAST_BASE_URL="https://portal.steadfast.com.bd/api/v1"

# ------------------------------------------------------------------------------
# 5. ASSET STORAGE (Object Storage / CDN)
# ------------------------------------------------------------------------------
# Options: 'local' | 's3' | 'cloudinary'
STORAGE_PROVIDER="local"

# AWS S3 / Cloudflare R2 / MinIO configuration (if STORAGE_PROVIDER="s3")
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1" # Mumbai or Singapore for low Bangladesh latency
AWS_BUCKET_NAME="shubban-marketplace-assets"
AWS_S3_ENDPOINT="" # Optional custom endpoint for Cloudflare R2 or MinIO
CDN_PUBLIC_URL="https://cdn.shubbanlibrary.com"

# Cloudinary configuration (if STORAGE_PROVIDER="cloudinary")
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# 6. DEVSECOPS, RATE LIMITING & SECURITY
# ------------------------------------------------------------------------------
# Max requests per window before HTTP 429 Too Many Requests
RATE_LIMIT_LOGIN_MAX=10          # 10 attempts per minute per IP
RATE_LIMIT_REGISTER_MAX=5        # 5 registrations per 10 minutes per IP
RATE_LIMIT_UPLOAD_MAX=20         # 20 uploads per minute per IP
FILE_MAX_IMAGE_MB=5              # 5MB maximum image upload size
FILE_MAX_PDF_MB=30               # 30MB maximum PDF upload size

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY, MONITORING & ERROR TRACKING
# ------------------------------------------------------------------------------
# Sentry Error Reporting DSN
SENTRY_DSN=""
# Logging Level: debug | info | warn | error
LOG_LEVEL="info"

